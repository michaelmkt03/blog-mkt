<style>
  :root{
    --orange:#FAAA3F; --cream:#FEF3E2; --cream2:#FFDDB3; --navy:#1D1F26; --ink:#1A1A1A;
    --gray:#5D5D5D; --taupe:#8C7973; --card:#F7F5F3; --bord:#EAE5E0; --bg:#FFFFFF;
    --green:#2E6E5B; --teal:#3E8EA8; --violet:#4A5A8C; --burg:#A34A4A; --red:#C0392B;
  }
  *{box-sizing:border-box}
  html,body{height:100%}
  body{margin:0;background:var(--bg);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;font-size:13px;line-height:1.4;display:flex;flex-direction:column}
  header{padding:12px 16px 0;border-bottom:1px solid var(--bord);background:#fff;position:sticky;top:0;z-index:5}
  h1{margin:0 0 2px;font-size:18px;color:var(--navy)}
  .sub{color:var(--taupe);font-size:12px;margin-bottom:8px}
  .tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px}
  .tab{border:1px solid var(--bord);background:var(--card);color:var(--gray);padding:6px 11px;border-radius:999px;cursor:pointer;font-size:12.5px}
  .tab:hover{border-color:var(--orange)}
  .tab.on{background:var(--orange);border-color:var(--orange);color:#fff;font-weight:600}
  .ctl{display:flex;gap:8px;align-items:center;flex-wrap:wrap;padding-bottom:10px}
  .ctl button{border:1px solid var(--bord);background:#fff;padding:5px 10px;border-radius:6px;cursor:pointer;font-size:12px;color:var(--navy)}
  .ctl button:hover{background:var(--cream)}
  .ctl input[type=search]{border:1px solid var(--bord);border-radius:6px;padding:5px 9px;font-size:12px;min-width:220px}
  .ctl label{color:var(--taupe);font-size:12px}
  .hint{color:var(--taupe);font-size:11.5px;margin-left:auto}
  main{flex:1;overflow:auto;background:
    linear-gradient(var(--bord) 1px, transparent 1px) 0 0/28px 28px,
    linear-gradient(90deg,var(--bord) 1px, transparent 1px) 0 0/28px 28px, #FCFBFA}
  .canvas{padding:28px 60px 80px 28px;transform-origin:0 0;display:inline-block;min-width:100%}

  /* tree */
  .tree, .tree ul{list-style:none;margin:0;padding:0}
  .tree ul{padding-left:34px;position:relative}
  .tree li{position:relative;display:flex;align-items:flex-start;padding:3px 0}
  .tree li > .node{position:relative;z-index:1}
  .tree li > ul{display:flex;flex-direction:column;justify-content:center}
  .tree li.collapsed > ul{display:none}
  /* connectors */
  .tree ul > li::before{content:"";position:absolute;left:-34px;top:50%;width:34px;height:0;border-top:2px solid var(--taupe);opacity:.55}
  .tree ul > li::after{content:"";position:absolute;left:-34px;top:0;bottom:0;border-left:2px solid var(--taupe);opacity:.55}
  .tree ul > li:first-child::after{top:50%}
  .tree ul > li:last-child::after{bottom:50%}
  .tree ul > li:only-child::after{display:none}

  .node{display:inline-flex;align-items:center;gap:7px;max-width:380px;background:#fff;border:1.5px solid var(--bord);border-radius:9px;padding:6px 10px;cursor:default;box-shadow:0 1px 2px rgba(0,0,0,.04)}
  .node.has{cursor:pointer}
  .node.has:hover{border-color:var(--orange);box-shadow:0 2px 6px rgba(250,170,63,.25)}
  .node .tg{flex:none;width:16px;height:16px;border-radius:50%;background:var(--navy);color:#fff;font-size:11px;line-height:16px;text-align:center;font-weight:700}
  li.collapsed > .node .tg{background:var(--orange)}
  .node .tx{font-weight:600;color:var(--navy)}
  .node .dt{display:block;font-weight:400;color:var(--gray);font-size:11.5px;margin-top:2px}
  .node .cnt{flex:none;font-size:10.5px;color:var(--taupe);border:1px solid var(--bord);border-radius:999px;padding:0 6px}
  /* depth colors */
  .d0 > .node{background:var(--navy);border-color:var(--navy);padding:10px 14px;max-width:300px}
  .d0 > .node .tx{color:#fff;font-size:15px}
  .d0 > .node .dt{color:#D5CEC7}
  .d0 > .node .tg{background:var(--orange)}
  .d1 > .node{background:var(--cream);border-color:var(--cream2)}
  .d1 > .node .tx{color:var(--ink)}
  .d2 > .node{border-left:4px solid var(--teal)}
  .d3 > .node{border-left:4px solid var(--violet)}
  .d4 > .node{border-left:4px solid var(--green)}
  .d5 > .node{border-left:4px solid var(--burg)}
  .node.hit{outline:2px solid var(--orange);background:#FFF4E4}
  .node .tag{flex:none;font-size:10px;font-weight:700;border-radius:4px;padding:1px 5px;color:#fff}
  .tag.red{background:var(--red)} .tag.grn{background:var(--green)} .tag.nav{background:var(--navy)} .tag.tau{background:var(--taupe)} .tag.org{background:var(--orange);color:var(--ink)}
  @media (max-width:640px){ .node{max-width:260px} .tree ul{padding-left:22px} .tree ul>li::before,.tree ul>li::after{left:-22px} .tree ul>li::before{width:22px} }
</style>
