const canvas = document.getElementById('canvas');
const tabs = document.getElementById('tabs');
let cur = 0;
const DEFAULT_DEPTH = 2;

function count(n){ return (n.c||[]).reduce((a,x)=>a+1+count(x),0); }

function build(n, depth){
  const li = document.createElement('li');
  li.className = 'd'+Math.min(depth,5);
  const node = document.createElement('div');
  node.className = 'node' + (n.c && n.c.length ? ' has' : '');
  if (n.c && n.c.length){
    const tg = document.createElement('span'); tg.className='tg'; tg.textContent='−'; node.appendChild(tg);
  }
  const body = document.createElement('span');
  const tx = document.createElement('span'); tx.className='tx'; tx.textContent = n.t; body.appendChild(tx);
  if (n.d){ const dt = document.createElement('span'); dt.className='dt'; dt.textContent = n.d; body.appendChild(dt); }
  node.appendChild(body);
  if (n.tag){ const [cls,txt] = n.tag.split('|'); const tag=document.createElement('span'); tag.className='tag '+cls; tag.textContent=txt; node.appendChild(tag); }
  if (n.c && n.c.length){ const c=document.createElement('span'); c.className='cnt'; c.textContent=count(n); node.appendChild(c); }
  li.appendChild(node);
  if (n.c && n.c.length){
    const ul = document.createElement('ul');
    n.c.forEach(ch => ul.appendChild(build(ch, depth+1)));
    li.appendChild(ul);
    if (depth >= DEFAULT_DEPTH) li.classList.add('collapsed');
    node.addEventListener('click', e => { e.stopPropagation(); li.classList.toggle('collapsed'); syncToggle(li); });
    syncToggle(li);
  }
  return li;
}
function syncToggle(li){ const tg = li.querySelector(':scope > .node .tg'); if (tg) tg.textContent = li.classList.contains('collapsed') ? '+' : '−'; }

function render(i){
  cur = i;
  canvas.innerHTML = '';
  const ul = document.createElement('ul'); ul.className='tree';
  ul.appendChild(build(MAPS[i].root, 0));
  canvas.appendChild(ul);
  [...tabs.children].forEach((t,k)=>t.classList.toggle('on', k===i));
  document.getElementById('q').value='';
  try{ localStorage.setItem('svl_mm_tab', i); }catch(e){}
}
MAPS.forEach((m,i)=>{ const b=document.createElement('button'); b.className='tab'; b.textContent=m.name; b.onclick=()=>render(i); tabs.appendChild(b); });

document.getElementById('bExpand').onclick = ()=>{ canvas.querySelectorAll('li.collapsed').forEach(li=>{li.classList.remove('collapsed'); syncToggle(li);}); };
document.getElementById('bCollapse').onclick = ()=>{ canvas.querySelectorAll('li').forEach(li=>{ const d=+li.className.replace(/\D/g,''); if (li.querySelector(':scope > ul')){ li.classList.toggle('collapsed', d>=DEFAULT_DEPTH); syncToggle(li);} }); };
document.getElementById('zoom').oninput = e => { canvas.style.transform = 'scale('+(e.target.value/100)+')'; };
document.getElementById('q').oninput = e => {
  const q = e.target.value.trim().toLowerCase();
  canvas.querySelectorAll('.node.hit').forEach(n=>n.classList.remove('hit'));
  if (!q) return;
  canvas.querySelectorAll('.node').forEach(n=>{
    if (n.textContent.toLowerCase().includes(q)){
      n.classList.add('hit');
      let p = n.parentElement;
      while (p && p !== canvas){ if (p.tagName==='LI' && p.classList.contains('collapsed')){ p.classList.remove('collapsed'); syncToggle(p);} p = p.parentElement; }
    }
  });
  const first = canvas.querySelector('.node.hit'); if (first) first.scrollIntoView({block:'center', inline:'center', behavior:'smooth'});
};

let start = 0; try{ start = +localStorage.getItem('svl_mm_tab') || 0; }catch(e){}
render(Math.min(start, MAPS.length-1));
</script>
