const flashEl=document.getElementById('flash'); let gMode='min';
function renderGloss(){
  const q=document.getElementById('gq').value.trim().toLowerCase();
  flashEl.innerHTML='';
  GLOSS.filter(g=> (gMode==='all'||g.min) && (!q || (g.w+' '+g.h+' '+g.b+' '+g.e).toLowerCase().includes(q))).forEach(g=>{
    const d=document.createElement('div'); d.className='fc'+(g.min?' min':'');
    d.innerHTML=`<div class="in"><div class="f"><div class="w">${g.w}</div><div class="hint">${g.h}</div><div class="hint" style="margin-top:auto">bấm để lật</div></div><div class="bk"><div>${g.b}</div>${g.e?`<div class="ex">Ví dụ: ${g.e}</div>`:''}</div></div>`;
    d.addEventListener('click',()=>d.classList.toggle('flip'));
    flashEl.appendChild(d);
  });
}
document.getElementById('gq').addEventListener('input',renderGloss);
document.getElementById('gMin').addEventListener('click',()=>{gMode='min';document.getElementById('gMin').classList.add('on');document.getElementById('gAll').classList.remove('on');renderGloss();});
document.getElementById('gAll').addEventListener('click',()=>{gMode='all';document.getElementById('gAll').classList.add('on');document.getElementById('gMin').classList.remove('on');renderGloss();});
document.getElementById('gFlipAll').addEventListener('click',()=>{const all=[...flashEl.querySelectorAll('.fc')];const any=all.some(x=>!x.classList.contains('flip'));all.forEach(x=>x.classList.toggle('flip',any));});
renderGloss();

