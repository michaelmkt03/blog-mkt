const ORDER=["s0","s1","tier0","s3","s4","q1","q2","q3","q7","tier1","s5","tier2","s6","s7","q4","q5","q6","tier3","tier4","s8","tier5"];
function wire(){
  document.querySelectorAll('label.chk').forEach(l=>{
    const id=l.dataset.id, cb=l.querySelector('input');
    cb.checked=!!state[id]; l.classList.toggle('done',cb.checked);
    cb.onchange=()=>{ state[id]=cb.checked; save(); l.classList.toggle('done',cb.checked); refresh(); };
  });
  refresh();
}
function refresh(){
  const all=ORDER.length, done=ORDER.filter(k=>state[k]).length;
  const pct=Math.round(done/all*100);
  document.getElementById('progBar').style.width=pct+'%';
  document.getElementById('progTxt').textContent=pct+'% · '+done+'/'+all+' mốc'+(pct===100?' · hoàn thành':'');
  const mp=document.querySelector('.mprog'); if(mp) mp.style.width=pct+'%';
  const mt=document.getElementById('mTxt'); if(mt) mt.textContent=pct+'% · '+done+'/'+all+' mốc';
  for(let n=0;n<=5;n++){ const t=document.getElementById('tier'+n); if(t) t.classList.toggle('done',!!state['tier'+n]); }
  const next=ORDER.find(k=>!state[k]);
  const el=document.getElementById('today');
  if(!next){ el.innerHTML='<b>Hoàn thành lộ trình.</b> Việc tiếp theo là tự dựng deck T10 theo skill.'; return; }
  const sec=next.startsWith('q')?'#s9':next.startsWith('tier')?'#s2':'#'+next;
  el.innerHTML=`<div>Hôm nay học gì?</div><b>${NAMES[next]}</b><button onclick="document.querySelector('${sec}').scrollIntoView({behavior:'smooth'})">Đi tới</button>`;
}
wire();

