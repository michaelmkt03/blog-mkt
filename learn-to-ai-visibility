// Chuẩn hóa: sắp xếp từ dài trước, tạo regex Unicode
const TIPIDX=[]; TIPS.forEach(t=>t.k.forEach(k=>TIPIDX.push({k,t})));
TIPIDX.sort((a,b)=>b.k.length-a.k.length);
const esc=s=>s.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');
const TIPRE=new RegExp('(?<![\\p{L}\\p{N}])('+TIPIDX.map(x=>esc(x.k)).join('|')+')(?![\\p{L}\\p{N}])','iu');
const tipByKey={}; TIPIDX.forEach(x=>tipByKey[x.k.toLowerCase()]=x.t);
function applyTooltips(root, limitPerTerm){
  const seen={}; limitPerTerm=limitPerTerm||2;
  const walker=document.createTreeWalker(root,NodeFilter.SHOW_TEXT,{acceptNode(n){
    if(!n.nodeValue.trim()) return NodeFilter.FILTER_REJECT;
    let p=n.parentElement; while(p && p!==root){ if(p.matches('.tt,.flash,script,style,input,button,#tip,.badge,.pill,.tag,h1,.k,.l,nav,.mbar')) return NodeFilter.FILTER_REJECT; p=p.parentElement; }
    return NodeFilter.FILTER_ACCEPT; }});
  const nodes=[]; while(walker.nextNode()) nodes.push(walker.currentNode);
  nodes.forEach(node=>{
    let text=node.nodeValue, cur=node;
    for(let guard=0; guard<30; guard++){
      const m=TIPRE.exec(text); if(!m) break;
      const key=m[1].toLowerCase(); seen[key]=(seen[key]||0)+1;
      const before=text.slice(0,m.index), hit=m[1], after=text.slice(m.index+hit.length);
      const frag=document.createDocumentFragment();
      if(before) frag.appendChild(document.createTextNode(before));
      if(seen[key]<=limitPerTerm){ const s=document.createElement('span'); s.className='tt'; s.tabIndex=0; s.dataset.key=key; s.textContent=hit; frag.appendChild(s); }
      else frag.appendChild(document.createTextNode(hit));
      const rest=document.createTextNode(after); frag.appendChild(rest);
      cur.parentNode.replaceChild(frag,cur); cur=rest; text=after;
    }
  });
}
// Hiện tooltip
const tipEl=document.createElement('div'); tipEl.id='tip'; document.body.appendChild(tipEl);
let tipTarget=null;
function showTip(el){
  const d=tipByKey[el.dataset.key]; if(!d) return;
  tipEl.innerHTML=`<b>${d.k[0]}</b>${d.t}${d.e?`<div class="ex">Ví dụ: ${d.e}</div>`:''}`;
  tipEl.style.display='block'; tipEl.className='';
  const r=el.getBoundingClientRect(), tw=tipEl.offsetWidth, th=tipEl.offsetHeight, vw=innerWidth, vh=innerHeight;
  let left=Math.min(Math.max(12, r.left+r.width/2-tw/2), vw-tw-12);
  let top=r.bottom+10, cls='below'; if(top+th>vh-8 && r.top-th-10>8){ top=r.top-th-10; cls='above'; }
  tipEl.style.left=left+'px'; tipEl.style.top=top+'px'; tipEl.className=cls;
  tipEl.style.setProperty('--ax',Math.max(10,Math.min(tw-20, r.left+r.width/2-left-5))+'px');
  document.querySelectorAll('.tt.on').forEach(x=>x.classList.remove('on')); el.classList.add('on'); tipTarget=el;
}
function hideTip(){ tipEl.style.display='none'; if(tipTarget) tipTarget.classList.remove('on'); tipTarget=null; }
const isTouch=matchMedia('(hover: none)').matches;
document.addEventListener('mouseover',e=>{ if(isTouch) return; const t=e.target.closest('.tt'); if(t) showTip(t); });
document.addEventListener('mouseout',e=>{ if(isTouch) return; if(e.target.closest('.tt')) hideTip(); });
document.addEventListener('click',e=>{ const t=e.target.closest('.tt'); if(t){ e.preventDefault(); if(tipTarget===t) hideTip(); else showTip(t); } else if(!e.target.closest('#tip')) hideTip(); });
document.addEventListener('focusin',e=>{ const t=e.target.closest('.tt'); if(t) showTip(t); });
document.addEventListener('focusout',e=>{ if(e.target.closest('.tt')) hideTip(); });
addEventListener('scroll',hideTip,{passive:true}); addEventListener('resize',hideTip);
// Áp dụng cho từng section (giới hạn 2 lần mỗi từ mỗi section)
document.querySelectorAll('main section').forEach(s=>applyTooltips(s,2));
const tipCount=document.querySelectorAll('.tt').length;
const hint=document.createElement('div'); hint.className='tiphint'; hint.textContent=`Chữ có gạch chấm là thuật ngữ, ${isTouch?'chạm':'rê chuột'} vào để xem giải thích. Trang này có ${tipCount} chỗ như vậy.`;
document.querySelector('#s0 .hero').after(hint);

// ---------- mobile: bọc bảng để cuộn ngang, menu thu gọn ----------
document.querySelectorAll('main table').forEach(t=>{ const w=document.createElement('div'); w.className='tblwrap'; t.parentNode.insertBefore(w,t); w.appendChild(t); });
const aside=document.getElementById('aside'), menuBtn=document.getElementById('menuBtn');
menuBtn.addEventListener('click',()=>{ const o=aside.classList.toggle('open'); menuBtn.setAttribute('aria-expanded',o); menuBtn.textContent=o?'✕ Đóng':'☰ Mục lục'; });
document.querySelectorAll('nav a').forEach(a=>a.addEventListener('click',()=>{ if(window.matchMedia('(max-width:900px)').matches){ aside.classList.remove('open'); menuBtn.textContent='☰ Mục lục'; } }));
document.getElementById('today').addEventListener('click',e=>{ if(e.target.tagName==='BUTTON' && window.matchMedia('(max-width:900px)').matches){ aside.classList.remove('open'); menuBtn.textContent='☰ Mục lục'; } });

// ---------- nav highlight ----------
const links=[...document.querySelectorAll('nav a')];
const secs=links.map(a=>document.querySelector(a.getAttribute('href')));
const io=new IntersectionObserver(es=>{es.forEach(e=>{if(e.isIntersecting){links.forEach(a=>a.classList.toggle('on',a.getAttribute('href')==='#'+e.target.id));}});},{rootMargin:'-30% 0px -60% 0px'});
secs.forEach(s=>s&&io.observe(s));

// ---------- section tabs ----------
document.querySelectorAll('#ptabs button').forEach(b=>b.addEventListener('click',()=>{
  document.querySelectorAll('#ptabs button').forEach(x=>x.classList.remove('on')); b.classList.add('on');
  document.querySelectorAll('.pane').forEach(p=>p.classList.toggle('on',p.id===b.dataset.p));
}));

// ---------- trend chart ----------
(function(){
  const months=["T1","T2","T3","T4","T5","T6","T7","T8","T9"];
  const series=[{c:"#1A1A1A",v:[332,402,424,473,943,924,887,882,823]},{c:"#FAAA3F",v:[408,400,343,398,697,633,604,750,714]},{c:"#8C7973",v:[317,333,310,336,527,473,478,581,510]}];
  const W=980,H=300,L=52,R=16,T=14,B=34,pw=W-L-R,ph=H-T-B,max=1000;
  const x=i=>L+pw*i/(months.length-1), y=v=>T+ph-ph*v/max; let s='';
  s+=`<rect x="${x(3)}" y="${T}" width="${x(4)-x(3)}" height="${ph}" fill="#EAE5E0" opacity=".55"/><text x="${(x(3)+x(4))/2}" y="${T+14}" text-anchor="middle" font-size="10" fill="#8C7973">Semrush đổi cách đo</text>`;
  for(let g=0;g<=1000;g+=250){ s+=`<line x1="${L}" y1="${y(g)}" x2="${W-R}" y2="${y(g)}" stroke="#EAE5E0"/><text x="${L-8}" y="${y(g)+4}" text-anchor="end" font-size="11" fill="#8C7973">${g}</text>`; }
  months.forEach((m,i)=>s+=`<text x="${x(i)}" y="${H-12}" text-anchor="middle" font-size="11" fill="#5D5D5D">${m}</text>`);
  series.forEach(se=>{ s+=`<path d="${se.v.map((v,i)=>(i?'L':'M')+x(i).toFixed(1)+' '+y(v).toFixed(1)).join(' ')}" fill="none" stroke="${se.c}" stroke-width="2.2"/>`; se.v.forEach((v,i)=>s+=`<circle cx="${x(i).toFixed(1)}" cy="${y(v).toFixed(1)}" r="3.2" fill="${se.c}"/>`); });
  document.getElementById('trend').innerHTML=s;
})();
